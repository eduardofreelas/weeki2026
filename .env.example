# Public build-time switch. Keep false for the static visual version.
NEXT_PUBLIC_PAYMENTS_API_ENABLED=false
NEXT_PUBLIC_FISCAL_MODULE_ENABLED=true
NEXT_PUBLIC_FISCAL_API_ENABLED=false
NEXT_PUBLIC_NFSE_NATIONAL_INTEGRATION_ENABLED=false
NEXT_PUBLIC_NFSE_AUTO_ISSUE_ENABLED=false
NEXT_PUBLIC_NFSE_WHATSAPP_ENABLED=false

# Backend only. Never prefix secrets with NEXT_PUBLIC_ or commit a populated .env.
APP_ORIGIN=http://localhost:3000
PORT=3000
DATABASE_URL=
# Base64 encoding of 32 random bytes; keep a separate encrypted backup.
PAYMENTS_ENCRYPTION_KEY=
PAYMENTS_ENVIRONMENT=sandbox
PAYMENTS_LIVE_ENABLED=false
PAYMENTS_ALERT_EMAIL=

# Fiscal backend. Keep sandbox until the complete homologation checklist is signed off.
FISCAL_MODULE_ENABLED=true
FISCAL_ENVIRONMENT=sandbox
FISCAL_LIVE_ENABLED=false
NFSE_NATIONAL_INTEGRATION_ENABLED=false
# Pin only URLs published in the official NFS-e portal for the selected environment.
NFSE_NATIONAL_BASE_URL=
# Server-only references for a managed KMS/Vault implementation. Never place PFX data or passwords here.
FISCAL_KMS_KEY_ID=
FISCAL_CERTIFICATE_VAULT_PATH=
FISCAL_DOCUMENT_BUCKET=
FISCAL_ALERT_EMAIL=

# OIDC confidential web application. Callback: APP_ORIGIN/api/payments/auth/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Mercado Pago application with OAuth + PKCE + offline_access/read/write permissions.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=

# Stripe Connect Standard, Direct Charges. Separate test and live credentials.
STRIPE_CONNECT_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional explicit version matching your Stripe account and Connect webhook endpoint.
STRIPE_API_VERSION=

# No global Asaas merchant key: provision each account using the server-only command.
