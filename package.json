{
  "name": "weeki-webapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:hostinger": "next build",
    "start": "npx serve out",
    "test": "npm run build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern build --ignore-pattern out",
    "build:payments": "tsc -p server/tsconfig.json",
    "build:full": "npm run build && npm run build:payments",
    "start:payments": "node --env-file-if-exists=.env build/payments/server/index.js",
    "db:migrate:payments": "node --env-file-if-exists=.env build/payments/server/migrate.js",
    "db:migrate": "npm run build:payments && node --env-file-if-exists=.env build/payments/server/migrate.js",
    "payments:provision-asaas": "node --env-file-if-exists=.env build/payments/server/provision-asaas.js",
    "build:payments:tests": "tsc -p server/tsconfig.tests.json",
    "test:server": "npm run build:payments:tests && node --test build/payments/server/tests/*.test.js",
    "test:payments": "npm run test:server",
    "test:fiscal": "npm run build:payments:tests && node --test build/payments/server/tests/fiscal*.test.js",
    "lint:payments": "eslint server shared features/payments components/payments components/weeki/settings-screen.tsx components/weeki/billing-screen.tsx components/weeki/finance-screen.tsx app/page.tsx --max-warnings=0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwindcss": "4.2.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6"
  },
  "type": "module"
}
